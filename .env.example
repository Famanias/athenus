# ==============================================================================
# ATHENUS KNOWLEDGE OS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development: cp .env.example .env
# ==============================================================================

# Application Metadata
PROJECT_NAME="Athenus Knowledge OS"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Local Database & Storage Paths
DATABASE_URL="sqlite:///./data/athenus.db"
QDRANT_PATH="./data/qdrant"
QDRANT_COLLECTION="transcript_chunks"
UPLOADS_DIR="./data/uploads"

# Local AI Models & Service Ports
DEFAULT_LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="llama3:8b"

DEFAULT_STT_PROVIDER="faster_whisper"
WHISPER_MODEL_SIZE="base"

DEFAULT_EMBEDDING_PROVIDER="sentence_transformers"
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"

# Desktop IPC & Security (Tauri injects IPC_BEARER_TOKEN on launch)
# IPC_BEARER_TOKEN=""

# Optional Cloud AI Providers (Uncomment and provide keys to enable Cloud/Hybrid Mode)
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""
# GEMINI_API_KEY=""
# CLAUDE_API_KEY=""
# DEEPGRAM_API_KEY=""
