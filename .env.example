# ==============================================================================
# ATHENUS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development: cp .env.example .env
# ==============================================================================

# Application Metadata
PROJECT_NAME="Athenus"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Published Host Ports (Docker Compose). Override only on port collisions.
# If PORT_BACKEND changes, also update NEXT_PUBLIC_API_URL below.
# PORT_FRONTEND=3000
# PORT_BACKEND=8000
# PORT_OLLAMA=11434

# Local Database & Storage Paths
DATABASE_URL="sqlite:///./data/athenus.db"
QDRANT_PATH="./data/qdrant"
QDRANT_COLLECTION="transcript_chunks"
UPLOADS_DIR="./data/uploads"

# Local AI Models & Service Ports
# NOTE: Values below target NATIVE development (backend run from ./backend).
# The Docker Compose stack overrides these with container-appropriate paths/URLs,
# so this file works for both native and containerized workflows.
DEFAULT_LLM_PROVIDER="ollama"
# Native: http://localhost:11434
# Container (default ollama service): http://ollama:11434
# Container (host Ollama passthrough): http://host.docker.internal:11434
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="llama3:8b"

DEFAULT_STT_PROVIDER="faster_whisper"
WHISPER_MODEL_SIZE="base"
# Faster-Whisper compute backend. Set WHISPER_DEVICE="cuda" (with
# WHISPER_COMPUTE_TYPE="float16") when using the Docker GPU profile or a local CUDA setup.
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

DEFAULT_EMBEDDING_PROVIDER="sentence_transformers"
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"

# Desktop IPC & Security (Tauri injects IPC_BEARER_TOKEN on launch)
# IPC_BEARER_TOKEN=""

# Optional Cloud AI Providers (Uncomment and provide keys to enable Cloud/Hybrid Mode)
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""
# GEMINI_API_KEY=""
# CLAUDE_API_KEY=""
# DEEPGRAM_API_KEY=""
