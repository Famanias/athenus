# Athenus Backend — GPU (NVIDIA CUDA)
# Same image as Dockerfile.dev, plus CUDA-enabled PyTorch for
# Faster-Whisper/CTranslate2 GPU inference. Requires NVIDIA Container Toolkit.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt

# Install CUDA-enabled PyTorch before requirements so the default build pulled
# in transitively by sentence-transformers is not installed.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# CTranslate2 (faster-whisper) is built against CUDA 12 and resolves its
# libraries via the system loader (not via torch's bundled RPATH). Install the
# CUDA 12 runtime wheels and expose them on LD_LIBRARY_PATH.
RUN pip install --no-cache-dir \
        nvidia-cublas-cu12 \
        nvidia-cuda-runtime-cu12 \
        nvidia-cudnn-cu12

ENV LD_LIBRARY_PATH="/usr/local/lib/python3.11/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.11/site-packages/nvidia/cudnn/lib"

COPY backend/ /app/

ENV WHISPER_DEVICE=cuda \
    WHISPER_COMPUTE_TYPE=float16

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
